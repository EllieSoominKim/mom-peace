# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./mompeace.db

# --- Gemini API ---
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- 식약처 공공데이터포털 API 키 ---
# https://www.data.go.kr 에서 발급 (푸드QR, 바코드연계제품정보, 식품원재료정보, 식품영양성분DB)
MFDS_API_KEY=your-mfds-api-key-here
